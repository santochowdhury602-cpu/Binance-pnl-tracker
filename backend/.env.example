# Binance API key — create with "Enable Reading" ONLY. Never enable withdrawals.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Comma-separated spot symbols you actually trade, e.g. BTCUSDT,ETHUSDT,SOLUSDT
SPOT_SYMBOLS=

# From @BotFather
TELEGRAM_BOT_TOKEN=

# Your deployed Render URL, used only by telegram_bot.py
WEBAPP_URL=

# Local dev only — Render sets this via the disk mount
DB_PATH=./data/pnl.db
