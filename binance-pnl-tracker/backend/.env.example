# Binance API key — create with "Enable Reading" ONLY. Never enable withdrawals.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Optional. Leave blank to auto-discover every coin you've spot-traded via
# the "Discover all coins" button instead of listing them manually.
SPOT_SYMBOLS=

# Optional. Quote assets to scan during discovery. Defaults to the common
# ones below if unset — widen or narrow as needed.
DISCOVER_QUOTE_ASSETS=USDT,BUSD,USDC,FDUSD,BTC,ETH,BNB,TRY,EUR

# From @BotFather
TELEGRAM_BOT_TOKEN=

# Your deployed Render URL, used only by telegram_bot.py
WEBAPP_URL=

# Local dev only — Render sets this via the disk mount
DB_PATH=./data/pnl.db
